<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.2/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!--
            Unit drives the service's own behaviour — ordering, locale
            fallback, lookup, caching — against a hand-built catalogue, so the
            assertions are about this plugin and not about ICU's opinions.

            Integration runs the REAL ICU catalogue. It is the only suite that
            can show the containment walk placing all 250 countries, the range
            tokens expanding correctly, and the numeric codes keeping their
            leading zeros — and it is the suite whose numbers move when the
            system's ICU is upgraded.
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">API</directory>
            <directory suffix=".php">Application</directory>
            <directory suffix=".php">Domain</directory>
            <directory suffix=".php">Infrastructure</directory>
        </include>
    </source>
</phpunit>
